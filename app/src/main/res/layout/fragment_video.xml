<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cameraView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transparentBar"
    android:orientation="vertical"
    tools:context="com.flipcam.VideoFragment">

    <com.flipcam.view.CameraView
        android:id="@+id/cameraSurfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <TextView
        android:id="@+id/pauseText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:text="@string/pausedText"
        android:textColor="@color/memoryConsumed"
        android:textStyle="bold"
        android:visibility="invisible" />

    <LinearLayout
        android:id="@+id/seekParent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="vertical"
        android:weightSum="1">

        <SeekBar
            android:id="@+id/zoomBar"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="0dp"
            android:contentDescription="@string/zoomControlDescription"
            android:progressBackgroundTint="@color/settingsBarColor"
            android:progressTint="@color/progressFill"
            android:thumb="@drawable/greencircle" />

        <LinearLayout
            android:id="@+id/videoFunctions"
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:layout_weight="0.90"
            android:background="@android:color/transparent"
            android:paddingBottom="8dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="1">

            <ImageButton
                android:id="@+id/substitute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="5dp"
                android:background="@color/transparentBar"
                android:contentDescription="@string/placeholderContentDescription"
                android:src="@drawable/placeholder" />

            <ImageButton
                android:id="@+id/switchCamera"
                android:layout_width="@dimen/cameraSideControlSize"
                android:layout_height="@dimen/cameraSideControlSize"
                android:layout_gravity="center_vertical"
                android:background="@drawable/camera_control_circle"
                android:contentDescription="@string/switchCamera"
                android:padding="14dp"
                android:src="@drawable/ic_video_switch_camera"
                android:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/cameraRecord"
                android:layout_width="@dimen/startButtonWidth"
                android:layout_height="@dimen/startButtonHeight"
                android:layout_gravity="center"
                android:layout_weight="0.08"
                android:background="@color/transparentBar"
                android:contentDescription="@string/recordVideo"
                android:padding="0dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_video_record_start" />

            <FrameLayout
                android:id="@+id/thumbnailParent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/thumbnail"
                    android:layout_width="@dimen/thumbnailWidth"
                    android:layout_height="@dimen/thumbnailHeight"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="5dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="0.06"
                    android:background="@drawable/camera_thumbnail_circle"
                    android:foreground="@drawable/camera_thumbnail_circle"
                    android:clipToOutline="true"
                    android:contentDescription="@string/thumbnail"
                    android:scaleType="centerCrop"
                    android:src="@drawable/placeholder" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
