<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:id="@+id/parentCamera">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:id="@+id/cameraPreview"
        >
    </FrameLayout>

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:id="@+id/settingsBar"
        android:background="@color/settingsBarColor"
        android:weightSum="3"
        >

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical">

            <ImageButton
                android:id="@+id/flashOn"
                android:layout_width="@dimen/flashOnWidth"
                android:layout_height="@dimen/flashOnHeight"
                android:layout_gravity="center"
                android:background="@color/transparentBar"
                android:contentDescription="@string/flashOn"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_video_flash_on" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical">

            <LinearLayout
                android:id="@+id/modeLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical">

            <TextView
                android:id="@+id/modeInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/modeInfoBottomMargin"
                android:background="@color/modeText"
                android:text="@string/VIDEO_MODE"
                android:textColor="@color/settingsBarColor" />

            <TextView
                android:id="@+id/resInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="@string/videoResolutionSelectorDescription"
                android:drawableEnd="@drawable/ic_dropdown_arrow"
                android:drawablePadding="3dp"
                android:focusable="true"
                android:onClick="chooseVideoResolution"
                android:paddingStart="4dp"
                android:paddingTop="3dp"
                android:paddingEnd="4dp"
                android:paddingBottom="3dp"
                android:textColor="@color/turqoise" />

            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical">

            <TextView
                android:id="@+id/storageDestination"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="@string/storageDestinationDescriptionDefault"
                android:drawableStart="@drawable/ic_storage_destination"
                android:drawablePadding="4dp"
                android:focusable="true"
                android:gravity="center"
                android:onClick="chooseStorageDestination"
                android:paddingStart="6dp"
                android:paddingTop="8dp"
                android:paddingEnd="6dp"
                android:paddingBottom="8dp"
                android:text="@string/storagePhoneShort"
                android:textColor="@color/turqoise"
                android:textSize="12sp" />
        </FrameLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/instantSettingsParent"
        android:layout_width="@dimen/instantSettingWidth"
        android:layout_height="120dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="80dp"
        android:layout_marginEnd="10dp"
        android:gravity="top|center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/toggleAudio"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginBottom="30dp"
            android:onClick="toggleMicrophone"
            android:contentDescription="@string/microphoneEnabled"
            android:src="@drawable/ic_video_mic_on" />

        <ImageView
            android:id="@+id/brightness"
            android:layout_width="@dimen/brightnessWidth"
            android:layout_height="@dimen/brightnessHeight"
            android:onClick="openBrightnessPopup"
            android:contentDescription="@string/brightnessContentDescription"
            android:background="?android:attr/selectableItemBackground"
            android:src="@drawable/ic_video_brightness" />

    </LinearLayout>

</FrameLayout>
