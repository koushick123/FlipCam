<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:id="@+id/parentCamera">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:id="@+id/cameraPreview"
        >
    </FrameLayout>

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/cameraControlSize"
        android:orientation="horizontal"
        android:id="@+id/settingsBar"
        android:background="@android:color/transparent"
        android:gravity="center_vertical"
        android:weightSum="3"
        >

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical">

            <ImageButton
                android:id="@+id/flashOn"
                android:layout_width="@dimen/flashOnWidth"
                android:layout_height="@dimen/flashOnHeight"
                android:layout_gravity="center"
                android:background="@color/transparentBar"
                android:contentDescription="@string/flashOn"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_video_flash_on" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical">

            <LinearLayout
                android:id="@+id/modeLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical">

            <TextView
                android:id="@+id/resInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingTop="3dp"
                android:paddingEnd="4dp"
                android:paddingBottom="3dp"
                android:textColor="@android:color/white" />

            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical">

        </FrameLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/cameraRightControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="132dp"
        android:gravity="end"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/instantSettingsParent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom|end"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/toggleAudio"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@string/microphoneEnabled"
                android:src="@drawable/ic_video_mic_on" />

            <ImageView
                android:id="@+id/brightness"
                android:layout_width="@dimen/brightnessWidth"
                android:layout_height="@dimen/brightnessHeight"
                android:contentDescription="@string/brightnessContentDescription"
                android:src="@drawable/ic_speed_dial_tune" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
